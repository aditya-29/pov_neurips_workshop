# Generated benchmark data — never commit.
# Leading slash matters: a bare `data/` also matches pov/prompts/data/, which
# silently kept every task prompt out of the repo. Anchor to the root.
/data/
/runs/
/outputs/

# Media artifacts
*.mp4
*.avi
*.mov
*.gif
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.gif

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Environments
.env/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Notebooks
.ipynb_checkpoints/

# Editor local-history extensions
.history/

# OS
.DS_Store
Thumbs.db

# Results are committed in full so a collaborator can check them: scored,
# summary, preds, manifests, resolved configs and reports. Only the media stays
# out -- 1.2 GB across 3420 clips, shared via the filesystem instead. Note that
# report*.html references media by relative path, so its players are empty
# without a local copy of data/*/*/media/.
#
# LICENCE NOTE: the committed ASL rows carry How2Sign translations verbatim, and
# the wbw_mcq rows carry MMLU stems and options verbatim. How2Sign is CC BY-NC
# 4.0, research use only, not redistributable. Keep this repository private, or
# redact before publishing -- scripts/redact_asl_scores.py does the ASL half.
!/data/*/*/eval/
!/data/*/*/eval/**/*.jsonl
!/data/*/*/*.jsonl
!/data/*/*/config.resolved.yaml
!/data/*/*/report*.html

# Scratch: slurm logs, probe outputs, generated report drafts.
/logs/
