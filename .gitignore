# Generated benchmark data — never commit.
# Leading slash matters: a bare `data/` also matches pov/prompts/data/, which
# silently kept every task prompt out of the repo. Anchor to the root.
/data/
/runs/
/outputs/

# Media artifacts
*.mp4
*.avi
*.mov
*.gif
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.gif

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Environments
.env/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/

# Notebooks
.ipynb_checkpoints/

# Editor local-history extensions
.history/

# OS
.DS_Store
Thumbs.db

# Results are committed; the media they describe is not (1.2 GB, 3420 files).
# scored.jsonl is a superset of preds.jsonl (every input field + score_*), so
# only scored/summary are kept -- preds would duplicate ~37 MB.
# report*.html is excluded: it references media by relative path and would ship
# broken players. Regenerate locally with `pov report`.
!/data/*/*/eval/
!/data/*/*/eval/**/scored.jsonl
!/data/*/*/eval/**/summary.jsonl
!/data/*/*/config.resolved.yaml

# ASL is the exception: How2Sign is CC BY-NC 4.0 and not redistributable, so its
# scored rows (which carry the translations verbatim) stay local and only the
# redacted copies are committed. See scripts/redact_asl_scores.py.
/data/asl/*/eval/**/scored.jsonl
!/data/asl/*/eval/**/scored.redacted.jsonl
